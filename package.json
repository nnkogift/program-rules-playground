        "@types/jest": "^30.0.0",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "changeset-conventional-commits": "^1.0.4",
        "eslint": "^10.4.0",
        "husky": "^9.1.7",
